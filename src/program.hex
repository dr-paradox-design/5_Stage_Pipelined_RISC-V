// RV32I regression program for the 5-STAGE PIPELINED core.
// Loaded by instruction_Memory.v via $readmemh; one 32-bit word per line.
// Expected final register state is asserted in Pipeline_Top_TestBench.v.
//
//=============================================================================
// THIS PROGRAM CONTAINS ZERO NOPs. THAT IS THE HEADLINE.
//
// Every earlier version of this file needed hand-inserted NOPs to keep the
// pipeline correct: 3 to space out data hazards, and 2 more in the branch
// delay slots. All 5 are gone. Not because the hazards went away, but because
// each one is now handled by hardware:
//
//     3 data-hazard NOPs  -> killed by forwarding      (Execute_Cycle.v)
//                            and the decode bypass     (Decode_Cycle.v)
//     2 delay-slot NOPs   -> killed by branch flushing (Hazard_Unit.v)
//
// A program that must be scheduled around the CPU's internal timing is not
// really running on a general-purpose processor - it is running on a trap. The
// whole point of this stage of the project is that arbitrary RV32I code now
// executes correctly on this core, and this file is the evidence.
//
//-----------------------------------------------------------------------------
// THIS IS A HAZARD TEST, NOT AN ARITHMETIC TEST
//
// The 17 computed values below are almost incidental - the instructions were
// chosen and ORDERED so that each of the five hazard mechanisms has at least
// one instruction that would produce a visibly WRONG answer if that mechanism
// were broken or removed. Read the per-line notes as a map of what each line
// is there to prove. A regression that passes only because the schedule is
// generous proves nothing; every one of these is deliberately tight.
//
//   mechanism                     proven by     breaks as
//   ----------------------------  ------------  ------------------------------
//   EX/MEM forwarding (dist 1)    idx2 (rs2)    x3 = 5  instead of 8
//   MEM/WB forwarding (dist 2)    idx2 (rs1)    x3 = 3  instead of 8
//   store-data forwarding         idx3          mem[0] = 0, so x9 = 0
//   load-use stall                idx5          x13 = 1  instead of 9
//   branch flush (ID/EX slot)     idx14         x11 = 99 instead of 0
//   branch flush (IF/ID slot)     idx15         x14 = 88 instead of 0
//   decode bypass (dist 3)        idx19         x17 = 0  instead of 7
//
//=============================================================================
// THE NOP ENCODING, FOR REFERENCE
//   0x00000013 is  addi x0, x0, 0  - the canonical RISC-V NOP. It no longer
//   appears anywhere in this program. Note that the hardware still MAKES nops
//   internally: a flush or a stall injects an all-zeros control word into a
//   pipeline register, which is the same idea implemented in silicon instead
//   of in the instruction stream. The bubbles did not disappear - they just
//   stopped being the programmer's problem.
//=============================================================================
//
// idx  addr   encoding   instruction          | why it is here
00500093   // 0   0x00   addi x1, x0, 5        | x1 = 5
00300113   // 1   0x04   addi x2, x0, 3        | x2 = 3
002081b3   // 2   0x08   add  x3, x1, x2       | x3 = 8. THE FORWARDING PROOF.
           //                                  |  rs1=x1 is 2 back  -> MEM/WB
           //                                  |  rs2=x2 is 1 back  -> EX/MEM
           //                                  |  One instruction exercising
           //                                  |  BOTH forwarding paths at once,
           //                                  |  with different answers if
           //                                  |  either is wrong: 3 if the
           //                                  |  MEM/WB path fails (x1 reads
           //                                  |  0), 5 if the EX/MEM path
           //                                  |  fails (x2 reads 0).
00302023   // 3   0x0c   sw   x3, 0(x0)        | mem[0] = 8. rs2=x3 is 1 back ->
           //                                  |  EX/MEM forward INTO THE
           //                                  |  STORE-DATA PATH specifically
           //                                  |  (WriteDataM <= ForwardedRD2E
           //                                  |  in Execute_Cycle.v). Easy fix
           //                                  |  to forget - it is a separate
           //                                  |  use of rs2 from the ALU one.
           //                                  |  Without it this stores 0 and
           //                                  |  the lw below reads 0 back.
00002483   // 4   0x10   lw   x9, 0(x0)        | x9 = 8. Not a register hazard:
           //                                  |  the store commits at the edge
           //                                  |  ending its MEM cycle and this
           //                                  |  load reads combinationally in
           //                                  |  the cycle right after, so no
           //                                  |  gap is needed.
00148693   // 5   0x14   addi x13, x9, 1       | x13 = 9. THE LOAD-USE PROOF.
           //                                  |  rs1=x9 comes from the lw
           //                                  |  DIRECTLY above. Forwarding
           //                                  |  cannot fix this one: while
           //                                  |  this instruction is in EX the
           //                                  |  lw is still in MEM, and the
           //                                  |  EX/MEM register holds the
           //                                  |  load's ADDRESS, not its data.
           //                                  |  Hazard_Unit.v stalls one
           //                                  |  cycle so the lw reaches WB and
           //                                  |  ordinary MEM/WB forwarding
           //                                  |  takes over. Without the stall
           //                                  |  x9 forwards as address 0 and
           //                                  |  x13 becomes 1.
40208233   // 6   0x18   sub  x4, x1, x2       | x4 = 2. x1/x2 are far back and
0020f2b3   // 7   0x1c   and  x5, x1, x2       | x5 = 5 & 3 = 1
0020e333   // 8   0x20   or   x6, x1, x2       | x6 = 5 | 3 = 7
001123b3   // 9   0x24   slt  x7, x2, x1       | x7 = (3 < 5) = 1
0020a433   // 10  0x28   slt  x8, x1, x2       | x8 = (5 < 3) = 0
00208463   // 11  0x2c   beq  x1, x2, +8       | NOT taken (5 != 3). Proves a
           //                                  |  fall-through does NOT flush -
           //                                  |  if FlushD/FlushE fired on any
           //                                  |  branch rather than only a
           //                                  |  TAKEN one, the addi below
           //                                  |  would be wrongly killed and
           //                                  |  x10 would stay 0.
00100513   // 12  0x30   addi x10, x0, 1       | x10 = 1 - the fall-through
00108663   // 13  0x34   beq  x1, x1, +12      | TAKEN (5 == 5) -> 0x34+12 = 0x40
06300593   // 14  0x38   addi x11, x0, 99      | MUST be flushed. When the branch
           //                                  |  is in EX this one has reached
           //                                  |  DECODE, so FlushE kills it.
           //                                  |  x11 must stay 0.
05800713   // 15  0x3c   addi x14, x0, 88      | MUST be flushed. When the branch
           //                                  |  is in EX this one is being
           //                                  |  FETCHED, so FlushD kills it.
           //                                  |  x14 must stay 0. Two separate
           //                                  |  registers for the two flush
           //                                  |  signals, so a failure tells
           //                                  |  you WHICH one is broken.
00700613   // 16  0x40   addi x12, x0, 7       | x12 = 7 - the branch target
00100793   // 17  0x44   addi x15, x0, 1       | x15 = 1  } spacers that put the
00200813   // 18  0x48   addi x16, x0, 2       | x16 = 2  } add below at dist 3
000608b3   // 19  0x4c   add  x17, x12, x0     | x17 = 7. THE DECODE-BYPASS
           //                                  |  PROOF. rs1=x12 is produced by
           //                                  |  idx16, EXACTLY 3 slots back -
           //                                  |  the one distance neither
           //                                  |  forwarding path reaches (too
           //                                  |  far) nor a plain register-file
           //                                  |  read handles (too close). When
           //                                  |  this instruction is in ID,
           //                                  |  idx16 is in WB writing x12 on
           //                                  |  the very edge this one latches
           //                                  |  its operands. The write-through
           //                                  |  bypass in Decode_Cycle.v
           //                                  |  catches it. Without it x17
           //                                  |  reads the stale x12 = 0.
//
//-----------------------------------------------------------------------------
// NOTE ON THE BRANCH OFFSET AT idx 13
//
//   The offset is +12, not the +8 you might expect, and the reason is worth
//   understanding: a taken branch kills exactly TWO instructions, so a test
//   that only skips ONE would leave half the flush logic unproven.
//
//        0x34  beq  x1, x1, +12
//        0x38  addi x11, x0, 99   <- killed by FlushE (it had reached DECODE)
//        0x3c  addi x14, x0, 88   <- killed by FlushD (it was being FETCHED)
//        0x40  addi x12, x0, 7    <- target:  0x40 - 0x34 = 12
//
//   With +8 the instruction at 0x3c would be the target itself: it would be
//   flushed out of IF/ID and then immediately re-fetched from the new PC, so
//   it would still execute and FlushD's correctness would be invisible. Two
//   distinct skipped instructions writing two distinct registers means a
//   failure in either flush path names itself in the regression output.
//
//   Encoding check for 0x00108663 against Sign_Extend.v's B-type unscramble
//   {{19{In[31]}}, In[31], In[7], In[30:25], In[11:8], 1'b0}:
//     In[31]=0, In[7]=0, In[30:25]=000000, In[11:8]=0110  ->  0_0_000000_0110_0
//     = 0b1100 = 12.  Correct.
//
//-----------------------------------------------------------------------------
// NOTE ON x11 AND x14
//   Neither is ever written by this program. They read back as 0 because
//   Register_file.v clears all 32 registers on reset. If the flush logic
//   silently failed, idx14 and/or idx15 would run and they would become 99 and
//   88 - which is what makes this a real test of branch behaviour rather than
//   a test that passes by accident.
//=============================================================================
