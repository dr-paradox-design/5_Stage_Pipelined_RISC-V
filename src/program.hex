// RV32I regression program for the 5-STAGE PIPELINED core.
// Loaded by instruction_Memory.v via $readmemh; one 32-bit word per line.
// Expected final register state is asserted in Pipeline_Top_TestBench.v.
//
//=============================================================================
// THIS PROGRAM CONTAINS ZERO NOPs. THAT IS THE HEADLINE.
//
// Every earlier version of this file needed hand-inserted NOPs to keep the
// pipeline correct: 3 to space out data hazards, and 2 more in the branch
// delay slots. All 5 are gone. Not because the hazards went away, but because
// each one is now handled by hardware:
//
//     3 data-hazard NOPs  -> killed by forwarding      (Execute_Cycle.v)
//                            and the decode bypass     (Decode_Cycle.v)
//     2 delay-slot NOPs   -> killed by branch flushing (Hazard_Unit.v)
//
// A program that must be scheduled around the CPU's internal timing is not
// really running on a general-purpose processor - it is running on a trap. The
// whole point of this stage of the project is that arbitrary RV32I code now
// executes correctly on this core, and this file is the evidence.
//
//-----------------------------------------------------------------------------
// THIS IS A HAZARD TEST, NOT AN ARITHMETIC TEST
//
// The 17 computed values below are almost incidental - the instructions were
// chosen and ORDERED so that each of the five hazard mechanisms has at least
// one instruction that would produce a visibly WRONG answer if that mechanism
// were broken or removed. Read the per-line notes as a map of what each line
// is there to prove. A regression that passes only because the schedule is
// generous proves nothing; every one of these is deliberately tight.
//
//   mechanism                     proven by     breaks as
//   ----------------------------  ------------  ------------------------------
//   EX/MEM forwarding (dist 1)    idx2 (rs2)    x3 = 5  instead of 8
//   MEM/WB forwarding (dist 2)    idx2 (rs1)    x3 = 3  instead of 8
//   store-data forwarding         idx3          mem[0] = 0, so x9 = 0
//   load-use stall                idx5          x13 = 1  instead of 9
//   branch flush (ID/EX slot)     idx14         x11 = 99 instead of 0
//   branch flush (IF/ID slot)     idx15         x14 = 88 instead of 0
//   decode bypass (dist 3)        idx19         x17 = 0  instead of 7
//
//=============================================================================
// THE NOP ENCODING, FOR REFERENCE
//   0x00000013 is  addi x0, x0, 0  - the canonical RISC-V NOP. It no longer
//   appears anywhere in this program. Note that the hardware still MAKES nops
//   internally: a flush or a stall injects an all-zeros control word into a
//   pipeline register, which is the same idea implemented in silicon instead
//   of in the instruction stream. The bubbles did not disappear - they just
//   stopped being the programmer's problem.
//=============================================================================
//
// idx  addr   encoding   instruction          | why it is here
00500093   // 0   0x00   addi x1, x0, 5        | x1 = 5
00300113   // 1   0x04   addi x2, x0, 3        | x2 = 3
002081b3   // 2   0x08   add  x3, x1, x2       | x3 = 8. THE FORWARDING PROOF.
           //                                  |  rs1=x1 is 2 back  -> MEM/WB
           //                                  |  rs2=x2 is 1 back  -> EX/MEM
           //                                  |  One instruction exercising
           //                                  |  BOTH forwarding paths at once,
           //                                  |  with different answers if
           //                                  |  either is wrong: 3 if the
           //                                  |  MEM/WB path fails (x1 reads
           //                                  |  0), 5 if the EX/MEM path
           //                                  |  fails (x2 reads 0).
00302023   // 3   0x0c   sw   x3, 0(x0)        | mem[0] = 8. rs2=x3 is 1 back ->
           //                                  |  EX/MEM forward INTO THE
           //                                  |  STORE-DATA PATH specifically
           //                                  |  (WriteDataM <= ForwardedRD2E
           //                                  |  in Execute_Cycle.v). Easy fix
           //                                  |  to forget - it is a separate
           //                                  |  use of rs2 from the ALU one.
           //                                  |  Without it this stores 0 and
           //                                  |  the lw below reads 0 back.
00002483   // 4   0x10   lw   x9, 0(x0)        | x9 = 8. Not a register hazard:
           //                                  |  the store commits at the edge
           //                                  |  ending its MEM cycle and this
           //                                  |  load reads combinationally in
           //                                  |  the cycle right after, so no
           //                                  |  gap is needed.
00148693   // 5   0x14   addi x13, x9, 1       | x13 = 9. THE LOAD-USE PROOF.
           //                                  |  rs1=x9 comes from the lw
           //                                  |  DIRECTLY above. Forwarding
           //                                  |  cannot fix this one: while
           //                                  |  this instruction is in EX the
           //                                  |  lw is still in MEM, and the
           //                                  |  EX/MEM register holds the
           //                                  |  load's ADDRESS, not its data.
           //                                  |  Hazard_Unit.v stalls one
           //                                  |  cycle so the lw reaches WB and
           //                                  |  ordinary MEM/WB forwarding
           //                                  |  takes over. Without the stall
           //                                  |  x9 forwards as address 0 and
           //                                  |  x13 becomes 1.
40208233   // 6   0x18   sub  x4, x1, x2       | x4 = 2. x1/x2 are far back and
0020f2b3   // 7   0x1c   and  x5, x1, x2       | x5 = 5 & 3 = 1
0020e333   // 8   0x20   or   x6, x1, x2       | x6 = 5 | 3 = 7
001123b3   // 9   0x24   slt  x7, x2, x1       | x7 = (3 < 5) = 1
0020a433   // 10  0x28   slt  x8, x1, x2       | x8 = (5 < 3) = 0
00208463   // 11  0x2c   beq  x1, x2, +8       | NOT taken (5 != 3). Proves a
           //                                  |  fall-through does NOT flush -
           //                                  |  if FlushD/FlushE fired on any
           //                                  |  branch rather than only a
           //                                  |  TAKEN one, the addi below
           //                                  |  would be wrongly killed and
           //                                  |  x10 would stay 0.
00100513   // 12  0x30   addi x10, x0, 1       | x10 = 1 - the fall-through
00108663   // 13  0x34   beq  x1, x1, +12      | TAKEN (5 == 5) -> 0x34+12 = 0x40
06300593   // 14  0x38   addi x11, x0, 99      | MUST be flushed. When the branch
           //                                  |  is in EX this one has reached
           //                                  |  DECODE, so FlushE kills it.
           //                                  |  x11 must stay 0.
05800713   // 15  0x3c   addi x14, x0, 88      | MUST be flushed. When the branch
           //                                  |  is in EX this one is being
           //                                  |  FETCHED, so FlushD kills it.
           //                                  |  x14 must stay 0. Two separate
           //                                  |  registers for the two flush
           //                                  |  signals, so a failure tells
           //                                  |  you WHICH one is broken.
00700613   // 16  0x40   addi x12, x0, 7       | x12 = 7 - the branch target
00100793   // 17  0x44   addi x15, x0, 1       | x15 = 1  } spacers that put the
00200813   // 18  0x48   addi x16, x0, 2       | x16 = 2  } add below at dist 3
000608b3   // 19  0x4c   add  x17, x12, x0     | x17 = 7. THE DECODE-BYPASS
           //                                  |  PROOF. rs1=x12 is produced by
           //                                  |  idx16, EXACTLY 3 slots back -
           //                                  |  the one distance neither
           //                                  |  forwarding path reaches (too
           //                                  |  far) nor a plain register-file
           //                                  |  read handles (too close). When
           //                                  |  this instruction is in ID,
           //                                  |  idx16 is in WB writing x12 on
           //                                  |  the very edge this one latches
           //                                  |  its operands. The write-through
           //                                  |  bypass in Decode_Cycle.v
           //                                  |  catches it. Without it x17
           //                                  |  reads the stale x12 = 0.
//
//=============================================================================
// PART 2 - THE OTHER FIVE BRANCHES  (idx 20..38)
//
// Everything above tests the PIPELINE. Everything below tests the ISA: the
// five conditional branches that this core, until now, got silently WRONG.
//
// THE BUG THIS SECTION EXISTS TO CATCH
//   main_decoder.v never looked at funct3, and the branch decision was the
//   single expression  PCSrc = branch & zero. All six B-type branches share
//   opcode 1100011 and are told apart ONLY by funct3, so all six were decoded
//   identically and all six were tested with the zero flag. Every one of them
//   executed as beq.
//
//   That is not a missing feature, it is a WRONG ANSWER. `bne x1, x2, L`
//   assembled fine, ran fine, and branched when x1 EQUALLED x2 - the exact
//   opposite of what it means. No exception, no warning. The tests below are
//   written so that the old hardware fails every single one of them.
//
// HOW EACH TEST IS BUILT
//   Every test is a branch followed by a "poison" instruction that writes a
//   distinctive non-zero value into an otherwise-untouched register. If the
//   branch goes the right way the poison is skipped and the register stays 0;
//   if it goes the wrong way the poison runs and names itself in the output.
//   Where the correct behaviour is NOT taken, the polarity is reversed - the
//   register is set to 1 by an instruction that only runs on a fall-through.
//   So both directions of every branch are covered, and no test can pass by
//   accident just because the pipeline happened to skip something.
//
// NOTE ON THE +8 OFFSETS
//   idx13 above uses +12 deliberately, to put two DISTINCT instructions in the
//   shadow of the branch and prove FlushD and FlushE separately. That job is
//   already done, so the branches below use a plain +8 and skip exactly one
//   instruction. The instruction at PC+8 is still fetched down the wrong path,
//   flushed, and then re-fetched from the redirected PC - so it executes
//   exactly once, just one cycle later than it looks. See the slot trace in
//   Pipeline_Top_TestBench.v.
//
//   mechanism                     proven by     breaks as
//   ----------------------------  ------------  ------------------------------
//   bne is not beq (taken)        idx22/23      x20 = 55 instead of 0
//   bne is not beq (not taken)    idx25/26      x22 = 0  instead of 1
//   blt, signed, negative rs1     idx27/28      x23 = 77 instead of 0
//   bltu differs from blt         idx29/30      x24 = 0  instead of 1
//   bge  = complement of blt      idx31/32      x25 = 66 instead of 0
//   bgeu = complement of bltu     idx33/34      x26 = 88 instead of 0
//   forwarding into a branch      idx36/37/38   x29 = 0  instead of 1
//=============================================================================
//
// The operand pair that makes signed and unsigned genuinely disagree.
// As SIGNED values:    -1 <  1            -> blt  taken, bge  not taken
// As UNSIGNED values:  4294967295 >  1    -> bltu not taken, bgeu taken
// Identical bits, opposite answers. A core that implements bltu as blt (or
// either of them as beq) cannot get both of the tests below right.
fff00913   // 20  0x50   addi x18, x0, -1      | x18 = 0xFFFFFFFF
00100993   // 21  0x54   addi x19, x0, 1       | x19 = 1
//
00209463   // 22  0x58   bne  x1, x2, +8       | x1=5, x2=3, so 5 != 3 -> TAKEN.
           //                                  |  THE HEADLINE TEST. Under the
           //                                  |  old zero-flag-only hardware
           //                                  |  this behaved as beq: 5 == 3 is
           //                                  |  false, so it would NOT branch
           //                                  |  and the poison below would run.
03700a13   // 23  0x5c   addi x20, x0, 55      | MUST be skipped. x20 stays 0.
00100a93   // 24  0x60   addi x21, x0, 1       | x21 = 1 - the branch target.
           //                                  |  Confirms we landed where we
           //                                  |  meant to, not just that we
           //                                  |  left. (This one is fetched
           //                                  |  down the wrong path, flushed,
           //                                  |  and re-fetched - see the note
           //                                  |  on +8 offsets above.)
//
00109463   // 25  0x64   bne  x1, x1, +8       | 5 != 5 is FALSE -> NOT taken.
           //                                  |  The negative half of the bne
           //                                  |  test. As beq this WOULD be
           //                                  |  taken and would wrongly skip
           //                                  |  the next line. Testing only
           //                                  |  the taken direction would let
           //                                  |  an "always branch" bug pass.
00100b13   // 26  0x68   addi x22, x0, 1       | x22 = 1 via fall-through.
//
01394463   // 27  0x6c   blt  x18, x19, +8     | -1 < 1 SIGNED -> TAKEN.
           //                                  |  Needs the N^V comparison, not
           //                                  |  the zero flag. As beq: -1 == 1
           //                                  |  is false -> not taken -> poison
           //                                  |  runs.
04d00b93   // 28  0x70   addi x23, x0, 77      | MUST be skipped. x23 stays 0.
//
01396463   // 29  0x74   bltu x18, x19, +8     | 0xFFFFFFFF < 1 UNSIGNED is
           //                                  |  FALSE -> NOT taken. Same two
           //                                  |  registers as the blt above,
           //                                  |  opposite outcome. This pair is
           //                                  |  the whole point: it is the one
           //                                  |  test that a core treating
           //                                  |  unsigned compares as signed
           //                                  |  cannot pass, because passing
           //                                  |  both requires answering the
           //                                  |  SAME BITS two different ways.
00100c13   // 30  0x78   addi x24, x0, 1       | x24 = 1 via fall-through.
//
0129d463   // 31  0x7c   bge  x19, x18, +8     | 1 >= -1 SIGNED -> TAKEN.
           //                                  |  Operands swapped relative to
           //                                  |  the blt, so this is its exact
           //                                  |  complement - checks that
           //                                  |  funct3[0] really does invert
           //                                  |  the condition.
04200c93   // 32  0x80   addi x25, x0, 66      | MUST be skipped. x25 stays 0.
//
01397463   // 33  0x84   bgeu x18, x19, +8     | 0xFFFFFFFF >= 1 UNSIGNED ->
           //                                  |  TAKEN. Complement of the bltu
           //                                  |  at idx29, and the fourth
           //                                  |  corner of the signed/unsigned
           //                                  |  x taken/not-taken square.
05800d13   // 34  0x88   addi x26, x0, 88      | MUST be skipped. x26 stays 0.
00100d93   // 35  0x8c   addi x27, x0, 1       | x27 = 1 - the bgeu target.
//
// Last test: the NEW branch logic must still see FORWARDED operands. The
// condition evaluator moved out of the decoder and now sits next to the ALU in
// EX, reading its flags - so it is fed by SrcAE/ForwardedRD2E, downstream of
// the forwarding muxes. This check makes sure that is actually true.
00300e13   // 36  0x90   addi x28, x0, 3       | x28 = 3
002e1463   // 37  0x94   bne  x28, x2, +8      | rs1=x28 is produced ONE
           //                                  |  instruction back, so it must
           //                                  |  arrive by EX/MEM forwarding.
           //                                  |  3 != 3 is FALSE -> NOT taken.
           //                                  |  If x28 were read stale as 0,
           //                                  |  then 0 != 3 is TRUE and the
           //                                  |  branch would wrongly fire -
           //                                  |  which is why the expected
           //                                  |  outcome here is deliberately
           //                                  |  NOT-taken. A test where the
           //                                  |  stale value gave the same
           //                                  |  answer would prove nothing.
00100e93   // 38  0x98   addi x29, x0, 1       | x29 = 1 via fall-through.
//
//=============================================================================
// PART 3 - THE FIRST REAL LOOP, AND THE SIGNED-OVERFLOW CORNER CASE
//
// WHY THIS SECTION HAD TO EXIST
//   Part 2 tests blt and bge with the operand pair (-1, 1). Those tests are
//   real, but they have a blind spot that only shows up under negative testing:
//   -1 - 1 = -2 does NOT overflow, so for that pair the raw sign bit N happens
//   to give the right answer and "blt = N" passes just as well as the correct
//   "blt = N ^ V". Deliberately breaking Branch_Condition.v to use N alone did
//   not fail a single signed-compare check.
//
//   A test that cannot fail is not a test. The V correction is the subtlest
//   line in Branch_Condition.v and the easiest one to get wrong, so it needs an
//   operand pair that actually overflows:
//
//        0x80000000 - 1  =  0x7FFFFFFF
//
//        true answer : -2147483648 < 1, so blt MUST be taken
//        raw sign bit: sum[31] = 0, so N = 0  ->  "not less"  (WRONG)
//        overflow    : V = 1, so N ^ V = 1    ->  "less"      (RIGHT)
//
//   That is the single case where the two implementations disagree, and it is
//   now tested below.
//
// THE PROBLEM: 0x80000000 IS UNREACHABLE WITH THIS INSTRUCTION SET
//   addi's immediate is 12 bits signed, so a single instruction can only
//   produce values in [-2048, 2047]. This core has no lui, no shifts, and no
//   multiply. The ONLY way to build 2^31 is to start at 1 and double it 31
//   times.
//
// THE SOLUTION: WRITE A LOOP - WHICH IS NOW POSSIBLE FOR THE FIRST TIME
//   31 doublings unrolled would be 31 lines of noise. With a working bne they
//   become a 3-instruction loop. This is the first genuine loop this processor
//   has ever run, and it is worth pausing on why it could not have been written
//   before today:
//
//     * a loop needs a BACKWARD branch, and every backward branch is
//       conditional on "am I done yet?" - which is an INEQUALITY test. beq
//       alone cannot express "keep going while the counter is not zero".
//       That is not a convenience; a machine with only beq cannot loop over a
//       countdown at all without contorting the code.
//     * before the hazard unit, the loop body's `addi x31, x31, -1` feeding
//       `bne x31, x0` one instruction later would have read a stale counter and
//       looped forever or exited early.
//
//   So this loop is simultaneously a test of the new branch conditions AND a
//   test that everything built earlier still holds up under a control-flow
//   pattern no straight-line program can produce. Note especially the two tight
//   dependencies inside it - the counter feeds the branch that tests it from
//   ONE instruction back, so every one of the 31 iterations depends on EX/MEM
//   forwarding delivering the decrement into the branch comparison.
//
//   mechanism                     proven by     breaks as
//   ----------------------------  ------------  ------------------------------
//   backward branch / looping     idx41-43      x30 wrong, or the sim hangs
//   forwarding into a loop branch idx42/43      wrong iteration count
//   blt uses N^V, not N alone     idx44/45      x31 = 99 instead of 0
//=============================================================================
00100f13   // 39  0x9c   addi x30, x0, 1       | x30 = 1     - the value
01f00f93   // 40  0xa0   addi x31, x0, 31      | x31 = 31    - the counter
//
//                                   LOOP TOP (0xa4). 31 iterations.
01ef0f33   // 41  0xa4   add  x30, x30, x30    | x30 *= 2. The only way to shift
           //                                  |  left on a core with no shifter
           //                                  |  - adding a number to itself IS
           //                                  |  a left shift by one.
ffff8f93   // 42  0xa8   addi x31, x31, -1     | x31--
fe0f9ce3   // 43  0xac   bne  x31, x0, -8      | loop while x31 != 0. Branches
           //                                  |  BACKWARD to 0xa4: offset is
           //                                  |  0xa4 - 0xac = -8. rs1=x31 was
           //                                  |  written by the instruction
           //                                  |  DIRECTLY above, so all 31
           //                                  |  iterations depend on EX/MEM
           //                                  |  forwarding reaching the branch
           //                                  |  comparison. Without it the
           //                                  |  branch would test a stale
           //                                  |  counter every time.
//                                   After 31 iterations: x30 = 2^31 = 0x80000000
//                                                        x31 = 0
//
//   ENCODING NOTE - THE ONE I GOT WRONG THE FIRST TIME, AND HOW IT SHOWED UP
//     A B-type immediate is stored scrambled, and the low nibble is the easy
//     part to fumble. For -8, the 13-bit two's-complement value is
//
//          1_111111_1100_0        imm[12] imm[10:5] imm[4:1] imm[0]
//
//     Note imm[3] is SET: -8 is ...11111000, so bits 3 and 4 are both 1 and
//     imm[4:1] = 1100. Writing it as 1000 (an easy slip - it looks like the
//     "8") yields fe0f98e3 instead of fe0f9ce3, which is a valid instruction
//     with offset -16 rather than -8.
//
//     What made that interesting is the SYMPTOM. -16 from 0xac lands on 0x9c,
//     which is `addi x30, x0, 1` - so every iteration re-initialised BOTH the
//     value and the counter and the loop ran forever, with x30 and x31 frozen
//     at 1 and 30. The regression did not report "loop is broken"; it reported
//     three unrelated-looking wrong values, and the real clue was that x30 = 1
//     is a value only the SETUP instruction can produce. A branch with a wrong
//     offset is still a perfectly legal branch - which is the same lesson as
//     bne-decoding-as-beq, one level up.
//
013f4463   // 44  0xb0   blt  x30, x19, +8     | 0x80000000 < 1 SIGNED -> TAKEN.
           //                                  |  THE OVERFLOW TEST, and the only
           //                                  |  check in either program that
           //                                  |  can tell N^V from N. The
           //                                  |  subtraction 0x80000000 - 1
           //                                  |  overflows the signed range and
           //                                  |  produces 0x7FFFFFFF, whose sign
           //                                  |  bit is 0 - so N alone says
           //                                  |  "not less" and would fall
           //                                  |  through to the poison below.
           //                                  |  V = 1 flips it back to the
           //                                  |  truth.
06300f93   // 45  0xb4   addi x31, x0, 99      | MUST be skipped. x31 stays 0.
           //                                  |  (Reusing the loop counter as
           //                                  |  the poison register: it is
           //                                  |  already 0 on exit, and the
           //                                  |  register file is full.)
013f2e33   // 46  0xb8   slt  x28, x30, x19    | x28 = 1. Does DOUBLE DUTY.
           //                                  |  (a) It is the blt target, so a
           //                                  |      nonzero x28 confirms the
           //                                  |      branch landed here.
           //                                  |  (b) It re-asks the branch's
           //                                  |      question as an ARITHMETIC
           //                                  |      instruction. slt and blt
           //                                  |      must agree: both mean
           //                                  |      "signed rs1 < rs2".
           //                                  |
           //                                  |  They did NOT agree before
           //                                  |  today. ALU.v computed slt as
           //                                  |  the bare sign bit of A-B, with
           //                                  |  no overflow correction, so on
           //                                  |  these exact operands it
           //                                  |  returned 0 while blt (using
           //                                  |  N^V) was correctly taken - the
           //                                  |  same comparison answered two
           //                                  |  different ways inside one core.
           //                                  |  ALU.v now XORs V into slt too.
           //                                  |  This line is what stops that
           //                                  |  divergence from coming back.
           //                                  |  Overwrites the x28 = 3 from
           //                                  |  idx36, which had already done
           //                                  |  its job at idx37.
//
//=============================================================================
// PART 4 - I-TYPE ALU OPS (andi / ori / slti)
//
//   main_decoder.v used to give opcode 0010011 ALUOp=00 ("just add"), so every
//   OP-IMM instruction executed as addi no matter what funct3 said. Only addi
//   was right, and only by coincidence. Each line below has an operand pair
//   chosen so that the add-instead answer DIFFERS from the correct one.
//
//   The register file is full, so results go to DATA MEMORY instead
//   (mem[17..22], checked by check_mem in the testbench). x15 is the scratch
//   register: saved to mem[16] first and reloaded at the end, so its check_reg
//   still sees whatever idx17 originally produced.
//
//   Inputs used: x18 = 0xFFFFFFFF, x1 = 5.
//
//   instruction            correct       as add (old bug)
//   ---------------------  ------------  ----------------
//   andi x15, x18, 0x0f0   0x000000f0    0x000000ef
//   ori  x15, x1,  0x0f5   0x000000f5    0x000000fa
//   slti x15, x18, 0       1             0xffffffff
//   slti x15, x1,  -1      0             4
//   andi x15, x1,  -1      5             4          (imm is SIGN-extended)
//   addi x15, x1,  -2      3             3          (guard - see idx58)
//
//   xori / sltiu / slli / srli / srai are in PART 5: they needed the ALU
//   widened first (xor, sltu, shifter).
//=============================================================================
04f02023   // 47  0xbc   sw   x15, 64(x0)      | mem[16] = x15 (save scratch)
0f097793   // 48  0xc0   andi x15, x18, 0x0f0  | 0xf0
04f02223   // 49  0xc4   sw   x15, 68(x0)      | mem[17]. Store-data forwarding
           //                                  |  from the line directly above.
0f50e793   // 50  0xc8   ori  x15, x1, 0x0f5   | 0xf5
04f02423   // 51  0xcc   sw   x15, 72(x0)      | mem[18]
00092793   // 52  0xd0   slti x15, x18, 0      | 1   (-1 < 0 signed)
04f02623   // 53  0xd4   sw   x15, 76(x0)      | mem[19]
fff0a793   // 54  0xd8   slti x15, x1, -1      | 0   (5 < -1 is false)
04f02823   // 55  0xdc   sw   x15, 80(x0)      | mem[20]
fff0f793   // 56  0xe0   andi x15, x1, -1      | 5   (-1 sign-extends to all 1s)
04f02a23   // 57  0xe4   sw   x15, 84(x0)      | mem[21]
ffe08793   // 58  0xe8   addi x15, x1, -2      | 3. THE GUARD. imm = 0xffe, so
           //                                  |  instr bit 30 - the bit R-type
           //                                  |  uses to mean "sub" - is SET.
           //                                  |  Only op[5]=0 stops ALU_decoder
           //                                  |  turning this into 5-(-2) = 7.
04f02c23   // 59  0xec   sw   x15, 88(x0)      | mem[22]
04002783   // 60  0xf0   lw   x15, 64(x0)      | restore x15 from mem[16]
//
//=============================================================================
// PART 5 - XOR, SLTU AND THE SHIFTER (R-type and I-type)
//
//   The ALU had no xor, no unsigned compare and no shifter, and ALU_decoder
//   sent every funct3 it did not recognise to 000 = add. So all ten of
//   xor sltu sll srl sra  xori sltiu slli srli srai  silently added. Same
//   scratch scheme as part 4: x15 computes, results land in mem[23..34], and
//   x15 is reloaded from mem[16] at the end.
//
//   Inputs used: x1 = 5, x2 = 3, x6 = 7, x18 = 0xFFFFFFFF, x19 = 1,
//                x30 = 0x80000000.
//
//   instruction             correct       as add (old)  what it pins down
//   ----------------------  ------------  ------------  -------------------
//   xor   x15, x1, x6       2             12
//   sltu  x15, x19, x18     1             0             1 < 0xFFFFFFFF unsigned
//                                                       (signed slt says 0)
//   sltu  x15, x1, x2       0             8             5 < 3 is false
//   sll   x15, x1, x2       40            8
//   sll   x15, x19, x18     0x80000000    0             only rs2[4:0] = 31 is
//                                                       the shift amount
//   srl   x15, x30, x2      0x10000000    0x80000003    zeros shifted in
//   sra   x15, x30, x2      0xF0000000    0x80000003    sign bit shifted in
//   xori  x15, x1, -1       0xFFFFFFFA    4             xori -1 is bitwise NOT
//   sltiu x15, x19, -1      1             0             imm sign-extends to
//                                                       0xFFFFFFFF, THEN is
//                                                       compared unsigned
//   slli  x15, x1, 4        80            9
//   srli  x15, x30, 4       0x08000000    0x80000004
//   srai  x15, x30, 4       0xF8000000    0x80000404    instr[30] picks sra
//                                                       over srl, as in R-type
//=============================================================================
0060c7b3   // 61  0xf4   xor  x15, x1, x6      | 2
04f02e23   // 62  0xf8   sw   x15, 92(x0)      | mem[23]
0129b7b3   // 63  0xfc   sltu x15, x19, x18    | 1
06f02023   // 64  0x100  sw   x15, 96(x0)      | mem[24]
0020b7b3   // 65  0x104  sltu x15, x1, x2      | 0
06f02223   // 66  0x108  sw   x15, 100(x0)     | mem[25]
002097b3   // 67  0x10c  sll  x15, x1, x2      | 40
06f02423   // 68  0x110  sw   x15, 104(x0)     | mem[26]
012997b3   // 69  0x114  sll  x15, x19, x18    | 0x80000000. x18 is all ones;
           //                                  |  a shifter that used all 32
           //                                  |  bits of rs2 would give 0.
06f02623   // 70  0x118  sw   x15, 108(x0)     | mem[27]
002f57b3   // 71  0x11c  srl  x15, x30, x2     | 0x10000000
06f02823   // 72  0x120  sw   x15, 112(x0)     | mem[28]
402f57b3   // 73  0x124  sra  x15, x30, x2     | 0xF0000000
06f02a23   // 74  0x128  sw   x15, 116(x0)     | mem[29]
fff0c793   // 75  0x12c  xori x15, x1, -1      | 0xFFFFFFFA
06f02c23   // 76  0x130  sw   x15, 120(x0)     | mem[30]
fff9b793   // 77  0x134  sltiu x15, x19, -1    | 1
06f02e23   // 78  0x138  sw   x15, 124(x0)     | mem[31]
00409793   // 79  0x13c  slli x15, x1, 4       | 80
08f02023   // 80  0x140  sw   x15, 128(x0)     | mem[32]
004f5793   // 81  0x144  srli x15, x30, 4      | 0x08000000
08f02223   // 82  0x148  sw   x15, 132(x0)     | mem[33]
404f5793   // 83  0x14c  srai x15, x30, 4      | 0xF8000000. imm field is
           //                                  |  0x404: the 0x400 is the sra
           //                                  |  selector, NOT part of shamt.
08f02423   // 84  0x150  sw   x15, 136(x0)     | mem[34]
04002783   // 85  0x154  lw   x15, 64(x0)      | restore x15 from mem[16]
//
//=============================================================================
// PART 6 - lui AND auipc (U-type)
//
//   Both opcodes used to decode to all-zeros (RegWrite = 0), so they were
//   silent no-ops: x15 just kept its old value and every store below wrote 1.
//
//   instruction             correct       before (no-op)  what it pins down
//   ----------------------  ------------  --------------  -------------------
//   lui   x15, 0x12345      0x12345000    1               low 12 bits cleared
//   lui   x15, 0xfffff      0xFFFFF000    1               top bit set, no extend
//   auipc x15, 0   @0x168   0x00000168    1               operand A really is PC
//   auipc x15, 1   @0x170   0x00001170    1               PC + (1 << 12)
//   lui   x15, 0x78         0x00078000    99              THE FORWARDING TRAP
//
//   The trap: a U-type has no rs1, but instr[19:15] still holds immediate
//   bits. For lui x15,0x78 those bits are 01111 = 15 - so the forwarding unit
//   sees "rs1 = x15, and the instruction 1 ahead writes x15" and forwards 99.
//   Only the ALUSrcA mux sitting AFTER the forwarding mux (Execute_Cycle.v)
//   throws that away. Get the order of those two muxes wrong and this line
//   produces 99 + 0x78000.
//=============================================================================
123457b7   // 86  0x158  lui  x15, 0x12345     | 0x12345000
08f02623   // 87  0x15c  sw   x15, 140(x0)     | mem[35]
fffff7b7   // 88  0x160  lui  x15, 0xfffff     | 0xFFFFF000
08f02823   // 89  0x164  sw   x15, 144(x0)     | mem[36]
00000797   // 90  0x168  auipc x15, 0          | 0x168 = its own address
08f02a23   // 91  0x16c  sw   x15, 148(x0)     | mem[37]
00001797   // 92  0x170  auipc x15, 1          | 0x170 + 0x1000 = 0x1170
08f02c23   // 93  0x174  sw   x15, 152(x0)     | mem[38]
06300793   // 94  0x178  addi x15, x0, 99      | bait for the forwarding trap
000787b7   // 95  0x17c  lui  x15, 0x78        | 0x78000. rs1 FIELD = 15 = RdM.
08f02e23   // 96  0x180  sw   x15, 156(x0)     | mem[39]
04002783   // 97  0x184  lw   x15, 64(x0)      | restore x15 from mem[16]
//
//=============================================================================
// PART 7 - jal AND jalr
//
//   Both opcodes used to be silent no-ops, so execution just fell through
//   every jump. This part is a real call / return, plus the two jump-only
//   details that are easy to get wrong:
//
//     - the LINK value (rd = PC+4) has to reach rd through forwarding and the
//       decode bypass exactly like an ALU result does
//     - jalr's target is (rs1 + imm) with bit 0 CLEARED, and rs1 may need
//       forwarding from the instruction right before it
//
//   CONTROL FLOW (addresses):
//     0x188  jal  x15,+12  ------------------------> 0x194  (kills 0x18c,0x190)
//     0x194  store link                    mem[40] = 0x18c
//     0x198  jal  x15,+16  ------------------------> 0x1a8  CALL
//     0x1a8    store link inside "function" mem[42] = 0x19c
//     0x1ac    jalr x0,0(x15)  --------------------> 0x19c  RETURN
//     0x19c  addi x15,55 ; store           mem[41] = 55  (code after the call ran)
//     0x1a4  jal  x0,+16  (plain "j") -------------> 0x1b4  skip the function
//     0x1b4  addi x15,0x1c1  (ODD on purpose)
//     0x1b8  jalr x15,4(x15) ----------------------> 0x1c4  (0x1c5 & ~1)
//     0x1c4  store link                    mem[45] = 0x1bc
//     0x1c8  auipc x15,0 ; store           mem[46] = 0x1c8
//
//   The bit-0 check is indirect on purpose. instruction_Memory ignores A[1:0],
//   so fetching from 0x1c5 would still return the right instruction - the bug
//   would only show up as an ODD PC from then on. auipc reads that PC back:
//   0x1c8 if bit 0 was cleared, 0x1c9 if not.
//
//   mem[43] and mem[44] are POISON: only wrong-path stores (that a jump should
//   have flushed) can write them. They must stay 0.
//=============================================================================
00c007ef   // 98  0x188  jal  x15, +12         | x15 = 0x18c, go to 0x194
04d00793   // 99  0x18c  addi x15, x0, 77      | KILLED (would corrupt the link)
04200793   // 100 0x190  addi x15, x0, 66      | KILLED
0af02023   // 101 0x194  sw   x15, 160(x0)     | mem[40] = 0x18c
010007ef   // 102 0x198  jal  x15, +16         | CALL: x15 = 0x19c, go to 0x1a8
03700793   // 103 0x19c  addi x15, x0, 55      | return lands here
0af02223   // 104 0x1a0  sw   x15, 164(x0)     | mem[41] = 55
0100006f   // 105 0x1a4  jal  x0, +16          | "j 0x1b4" - rd = x0, link discarded
0af02423   // 106 0x1a8  sw   x15, 168(x0)     | FUNCTION: mem[42] = 0x19c
00078067   // 107 0x1ac  jalr x0, 0(x15)       | RETURN ("ret") -> 0x19c
0af02623   // 108 0x1b0  sw   x15, 172(x0)     | POISON mem[43] - killed by the return
1c100793   // 109 0x1b4  addi x15, x0, 0x1c1   | x15 = 0x1c1, odd
004787e7   // 110 0x1b8  jalr x15, 4(x15)      | rs1 forwarded from the line above.
           //                                  |  0x1c1 + 4 = 0x1c5 -> & ~1 = 0x1c4
           //                                  |  x15 = 0x1bc. rd == rs1: the
           //                                  |  target must use the OLD x15.
0af02823   // 111 0x1bc  sw   x15, 176(x0)     | POISON mem[44] - killed
0af02823   // 112 0x1c0  sw   x15, 176(x0)     | POISON mem[44] - killed
0af02a23   // 113 0x1c4  sw   x15, 180(x0)     | mem[45] = 0x1bc
00000797   // 114 0x1c8  auipc x15, 0          | 0x1c8 - proves bit 0 was cleared
0af02c23   // 115 0x1cc  sw   x15, 184(x0)     | mem[46]
04002783   // 116 0x1d0  lw   x15, 64(x0)      | restore x15 from mem[16]
//
//=============================================================================
// PART 8 - BYTE AND HALFWORD LOADS / STORES
//
//   Data_Memory used to be word-only and nobody looked at funct3 for memory
//   ops, so every lb/lh/lbu/lhu behaved as lw and every sb/sh as sw. Now
//   Load_Store_Unit.v picks byte lanes and does the sign / zero extension.
//
//   LOADS read one test word, mem[48] = 0x80FF7F01, whose four bytes cover
//   every case:  byte0 = 01   byte1 = 7F (positive)   byte2 = FF   byte3 = 80
//   (both negative, and 0x80FF is a negative half).
//
//   load             correct       as lw (old)
//   ---------------  ------------  ------------
//   lb  x15, 194     0xFFFFFFFF    0x80FF7F01   byte 2, sign-extended
//   lbu x15, 194     0x000000FF    0x80FF7F01   byte 2, zero-extended
//   lb  x15, 193     0x0000007F    0x80FF7F01   positive byte: no 1s filled
//   lh  x15, 194     0xFFFF80FF    0x80FF7F01   upper half, sign-extended
//   lhu x15, 194     0x000080FF    0x80FF7F01   upper half, zero-extended
//   lh  x15, 192     0x00007F01    0x80FF7F01   lower half, positive
//   lb  x15, 195     0xFFFFFF80    0x80FF7F01   top byte
//
//   Each load is followed by a store of x15, so every one of them also takes
//   the LOAD-USE STALL and then MEM/WB-forwards the EXTENDED value - proof
//   that extension happens before the MEM/WB register, not after it.
//
//   STORES must touch only their own byte lanes:
//     mem[49] starts 0:          sb 0x..CD @197 -> 0x0000CD00
//                                sh 0x34AB @198 -> 0x34ABCD00
//     mem[50] = 0xFFFFFFFF, then sb 0    @201 -> 0xFFFF00FF
//                                sh 0    @202 -> 0x000000FF
//   As sw (old) both words would have been overwritten whole.
//=============================================================================
80ff87b7   // 117 0x1d4  lui  x15, 0x80ff8     | 0x80FF8000. Its rs2 FIELD (imm
           //                                  |  bits) reads as 15 = the lw's rd
           //                                  |  above, so the hazard unit takes
           //                                  |  a needless 1-cycle stall. Known,
           //                                  |  harmless - see the U-type notes.
f0178793   // 118 0x1d8  addi x15, x15, -255   | 0x80FF7F01
0cf02023   // 119 0x1dc  sw   x15, 192(x0)     | mem[48] = the test word
0c200783   // 120 0x1e0  lb   x15, 194(x0)     | 0xFFFFFFFF
0cf02623   // 121 0x1e4  sw   x15, 204(x0)     | mem[51]
0c204783   // 122 0x1e8  lbu  x15, 194(x0)     | 0x000000FF
0cf02823   // 123 0x1ec  sw   x15, 208(x0)     | mem[52]
0c100783   // 124 0x1f0  lb   x15, 193(x0)     | 0x0000007F
0cf02a23   // 125 0x1f4  sw   x15, 212(x0)     | mem[53]
0c201783   // 126 0x1f8  lh   x15, 194(x0)     | 0xFFFF80FF
0cf02c23   // 127 0x1fc  sw   x15, 216(x0)     | mem[54]
0c205783   // 128 0x200  lhu  x15, 194(x0)     | 0x000080FF
0cf02e23   // 129 0x204  sw   x15, 220(x0)     | mem[55]
0c001783   // 130 0x208  lh   x15, 192(x0)     | 0x00007F01
0ef02023   // 131 0x20c  sw   x15, 224(x0)     | mem[56]
0c300783   // 132 0x210  lb   x15, 195(x0)     | 0xFFFFFF80
0ef02223   // 133 0x214  sw   x15, 228(x0)     | mem[57]
1234b7b7   // 134 0x218  lui  x15, 0x1234b     |
bcd78793   // 135 0x21c  addi x15, x15, -1075  | 0x1234ABCD
0cf002a3   // 136 0x220  sb   x15, 197(x0)     | mem[49] byte 1 = CD
0087d793   // 137 0x224  srli x15, x15, 8      | 0x001234AB
0cf01323   // 138 0x228  sh   x15, 198(x0)     | mem[49] bytes 3:2 = 34AB
0d202423   // 139 0x22c  sw   x18, 200(x0)     | mem[50] = 0xFFFFFFFF
0c0004a3   // 140 0x230  sb   x0, 201(x0)      | clear byte 1 only
0c001523   // 141 0x234  sh   x0, 202(x0)      | clear bytes 3:2 only
04002783   // 142 0x238  lw   x15, 64(x0)      | restore x15 from mem[16]
//
//-----------------------------------------------------------------------------
// NOTE ON THE BRANCH OFFSET AT idx 13
//
//   The offset is +12, not the +8 you might expect, and the reason is worth
//   understanding: a taken branch kills exactly TWO instructions, so a test
//   that only skips ONE would leave half the flush logic unproven.
//
//        0x34  beq  x1, x1, +12
//        0x38  addi x11, x0, 99   <- killed by FlushE (it had reached DECODE)
//        0x3c  addi x14, x0, 88   <- killed by FlushD (it was being FETCHED)
//        0x40  addi x12, x0, 7    <- target:  0x40 - 0x34 = 12
//
//   With +8 the instruction at 0x3c would be the target itself: it would be
//   flushed out of IF/ID and then immediately re-fetched from the new PC, so
//   it would still execute and FlushD's correctness would be invisible. Two
//   distinct skipped instructions writing two distinct registers means a
//   failure in either flush path names itself in the regression output.
//
//   Encoding check for 0x00108663 against Sign_Extend.v's B-type unscramble
//   {{19{In[31]}}, In[31], In[7], In[30:25], In[11:8], 1'b0}:
//     In[31]=0, In[7]=0, In[30:25]=000000, In[11:8]=0110  ->  0_0_000000_0110_0
//     = 0b1100 = 12.  Correct.
//
//-----------------------------------------------------------------------------
// NOTE ON x11 AND x14
//   Neither is ever written by this program. They read back as 0 because
//   Register_file.v clears all 32 registers on reset. If the flush logic
//   silently failed, idx14 and/or idx15 would run and they would become 99 and
//   88 - which is what makes this a real test of branch behaviour rather than
//   a test that passes by accident.
//=============================================================================
